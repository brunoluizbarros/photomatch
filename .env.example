# Postgres (Railway) — o próprio Postgres do projeto, sem credenciais do app-carneiros
DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:5432/railway
# Usada só durante o build (IS_BUILD=true); em geral igual à DATABASE_URL
DATABASE_PUBLIC_URL=

BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Railway Object Storage (S3-compatível)
STORAGE_ENDPOINT=https://storage.railway.app
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AWS Rekognition
REKOGNITION_REGION=us-east-1
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
REKOGNITION_FACE_MATCH_THRESHOLD=80
REKOGNITION_MAX_TPS=40
